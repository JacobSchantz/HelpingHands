ring_r=9.5;                 // Top ring radius (mm): Base 9: radius of the C-shaped rib under the top plate round each pivot, and of the groove it runs in, cut down into the handle-gear's hub. Below, the gear turns on the base's post; above, on this rib: the axle held at both ends. The finger's base hook lies over the pivot, so a post cannot run through it.
ring_w=2.6;                 // Top ring groove width (mm): Base 9: the groove's width across; the rib is ring_clear narrower each side.
ring_depth=2.5;             // Top ring groove depth (mm): Base 9: how deep the groove is cut into the handle-gear's top face; the rib reaches ring_clear short of its floor.
ring_clear=0.25;            // Top ring clearance (mm): Base 9: rib to groove, each side, at the floor and at the C's ends at the swing's limits.
ring_wall=1.5;              // Top ring wall to the finger (mm): Base 9: the groove stops this short of the finger's pocket, which is where the C is open.
pillar_d=8;                 // Top plate pillar (mm): Base 9: the three pillars the top plate stands on, from its underside to a socket in the base. Each takes an M3 countersunk screw from the base's underside.
pillar_rim=2;               // Plate rim round a pillar (mm): Base 9: how far both plates reach past each pillar.
pillar_pin_r=35;            // Lower pillars from the motor axis (mm): Base 9: the two lower pillars sit this far from the pinion's (motor's) axis, below it, clear of the pinion's teeth.
pillar_deg=40;              // Lower pillars' spread (deg): Base 9: each lower pillar sits this far either side of straight down from the motor axis.
pillar_top_z=25;            // Upper pillar height (mm): Base 9: the upper pillar sits on the centreline this far above the pivots, past the side gears' teeth at every swing and between the fingers.
pillar_socket=1.5;          // Pillar socket depth (mm): Base 9: each pillar's foot drops this deep into a socket in the base top, which locates the top plate on the base (and so the top rings on the posts' axes).
pillar_fit=0.15;            // Pillar socket fit (mm): Base 9: socket over the pillar, each side.
pillar_pilot_d=2.6;         // Pillar screw pilot (mm): Base 9: the hole up each pillar the M3 cuts its own thread in (blind, 1 mm under the top face).
top_access_clear=1;         // Pinion screw access clearance (mm): Base 9: the top plate's hole over the pinion clears its 3 flange screw heads by this much, so the pinion comes off with the plate on.
hub_d=35.6;                 // Hub diameter (mm): Base 10: the wrist hub, a disc bolted to the B601-RS J6 output (an RS00, the same flange as our motor: motor_out_pcd). Seeed's aluminium "Gripper Connector A" (2-M6-ROTOR.step) is 35.6; this printed one is its twin, so either fits every tool plate.
hub_t=6;                    // Hub thickness (mm): Base 10: Connector A is 6 thick. It sits on J6's 1 mm output boss (its arm face is the boss top, link6 z 0 in Seeed's URDF).
hub_bore_d=14;              // Hub centre bore (mm): Base 10: the centre hole (Connector A: 14).
hub_screws=6;               // Hub screws to J6: Base 10: how many of the J6 output's motor_out_holes the hub is bolted through (Connector A: 4; the printed hub takes all 6). Must divide motor_out_holes.
hub_screw_phase_deg=0;      // Hub screw angle (deg): Base 10: the first J6 screw's angle from +x. J6 turns anyway, so only the hub's own features care.
hub_cbore_d=6;              // Hub screw counterbore (mm): Base 10: M3 socket heads sit in these, from the hub's tool face (Connector A: 6.0).
hub_cbore_h=3;              // Hub counterbore depth (mm): Base 10: depth of those counterbores; the rest is the screw grip (M3 x 6: 3 grip + 3 into J6's 5 deep holes).
hub_relief_d=4;             // Hub relief holes (mm): Base 10: 3 holes on 24.46 that clear the RS00 output's 3 x 3 mm features (Connector A: 4.0). 0 = none.
hub_relief_pcd=24.46;       // Hub relief circle (mm): Base 10: the RS00 drawing's 24.46 circle.
hub_scallop_d=7.06;         // Hub scallops (mm): Base 10: 4 notches round the hub's edge on the tool screws' circle (motor_back_pcd, 45 deg) clear those screws' heads, which stand in the tool plate's bore (Connector A: 7.06).
radial_n=3;                 // Radial screws: Base 10: how a tool locks onto the hub: M3 screws in from the tool plate's side into the hub's rim, as Seeed's stock gripper does (Connector B to A: 3 at 120 deg). Loosen 3 screws, lift the tool off, slide the next one on.
radial_phase_deg=30;        // Radial screw angle (deg): Base 10: the first radial screw's angle from +x (Connector A: 30, 150, 270). Kept 45 deg off the tool screws, and the Aero plate's cable channel sits between two of them.
radial_pilot_d=2.5;         // Radial pilot (hub) (mm): Base 10: the printed hub's radial holes; the M3 cuts its own thread (Connector A is tapped M3).
radial_pilot_len=6;         // Radial pilot depth (mm): Base 10: how deep they run in from the hub's rim.
tool_d=56.8;                // Tool plate diameter (mm): Base 10: the tool plate, every tool's side of the interface: the twin of Seeed's "Gripper Connector B" (2-M7-STATOR.step, 56.8), the RS00's own diameter.
tool_t=9.5;                 // Tool plate thickness (mm): Base 10: Connector B: 9.5, of which tool_floor is the floor and the rest the socket the hub drops into.
tool_floor=3;               // Tool plate floor (mm): Base 10: the floor between the socket and the tool (Connector B: 3). The hub's tool face seats on it.
tool_bore_d=36;             // Socket bore (mm): Base 10: the socket for the hub (Connector B: 36.0, so the 35.6 hub has 0.2 a side).
tool_center_d=26.2;         // Tool plate centre hole (mm): Base 10: the floor's centre hole (Connector B: 26.2).
tool_screw_pcd=38;          // Tool screw circle (mm): Base 10: 4 x M3 on 38 at 45 deg, through the floor into the tool. The RS00's back face has exactly this (motor_back_pcd), and so does the Aero Hand's wrist pad (4 M3 inserts on a 26.9 square, measured from its CAD): one tool plate fits both.
tool_screw_phase_deg=45;    // Tool screw angle (deg): Base 10: the first tool screw's angle (Connector B: 45).
tool_head_d=6.2;            // Tool screw head pocket (mm): Base 10: the 4 tool screws' heads stand on the floor in pockets half in the socket wall (Connector B: 6.2, 3.5 high); the hub's scallops clear them. Printed, each pocket runs on up to the socket's mouth, so nothing hangs over it.
radial_h=3;                 // Radial screw height (mm): Base 10: the radial screws' axis above the floor top: the hub's mid-thickness (Connector B: 3).
radial_clear_d=3.5;         // Radial clearance hole (mm): Base 10: the radial screws' clearance in the tool plate (Connector B: 3.5).
radial_head_d=5.8;          // Radial screw head counterbore (mm): Base 10: counterbore for the radial screws' heads, from the rim in to radial_seat_r (Connector B: 5.8).
radial_seat_r=21.9;         // Radial head seat (mm): Base 10: the heads seat this far from the axis (Connector B: spot faces at 21.9), so M3 x 8 reaches 4 mm into the hub.
mount_axis_y=0;             // J6 axis offset (dorsal) (mm): Base 10: where the arm's roll axis (J6) runs, along the fingers (Z), dorsal of the finger mid-plane. 0: through the fingers' mid-plane and between the fingers, as the stock gripper's fingers are, so rolling the wrist turns the fingers about their own centre line. -30 puts it nearer the motor (the centre of mass) and shortens the bracket.
mount_gap=1;                // Gap under the gripper (mm): Base 10: clearance between the bracket's foot and the gripper's lowest part (the base plate's pillars and the motor).
foot_t=8;                   // Foot thickness (mm): Base 10: the bracket's foot, the flat plate across the J6 axis that the tool plate screws to. It carries the gripper ~70 mm out from the leg (mount_axis_y 0), so it is thick: 8.
foot_pilot_d=2.5;           // Foot pilot holes (mm): Base 10: the 4 tool screws come up through the tool plate's floor into these (self-tapped, right through the foot: M3 x 10 = 3 floor + 7).
leg_t=5;                    // Leg thickness (mm): Base 10: the bracket's leg, a plate up the motor's back face, bolted to its 4 M3 (motor_back_pcd); M3 x 8 = 5 + 3 of the 4 mm thread.
leg_boss_r=6;               // Leg rim round each screw (mm): Base 10: the leg is the hull of a disc this big round each back-face screw and the foot.
gusset_t=5;                 // Gusset thickness (mm): Base 10: two ribs between leg and foot, on the leg's outer side at its edges.
gusset_len=15;              // Gusset size (mm): Base 10: each gusset's legs (a 45 deg triangle, so it prints without support). 15 keeps it under the lower leg screws' heads.
tie_x=30;                   // Cable tie x (mm): Base 10: the RS00's CAN + power cable comes off its connector (motor_conn_deg 0: the +x one) and is zip-tied to the foot here, then drops past the tool plate to J6, as the stock gripper's does.
tie_dy=7;                   // Cable tie y (from the motor back) (mm): Base 10: the tie point's y, measured in from the motor's back face (the connectors stand on the last motor_conn_len of the body).
tie_gap=9;                  // Tie slot spacing (mm): Base 10: the two zip-tie slots straddle the cable this far apart (centre to centre).
tie_w=4.5;                  // Tie slot length (mm): Base 10: each slot's long side (a 3.6 mm zip tie).
tie_slot_t=2;               // Tie slot width (mm): Base 10: each slot's short side.
aero_spacer=8;              // Aero plate spacer (mm): Base 10: the Aero Hand's tool plate is a tool plate plus this much more below the floor, so the hand's USB and 6 V leads leave its wrist pad's 15 mm centre hole sideways in a channel instead of being pinched by the 3 mm floor. M3 x 14: 3 floor + 8 spacer + 3 into the hand's inserts.
aero_channel_w=10;          // Cable channel width (mm): Base 10: the channel in the plate's hand face, from the centre to the rim.
aero_channel_h=3;           // Cable channel depth (mm): Base 10: its straight walls' height; the roof above them peaks at 45 deg (aero_channel_w/2 higher), so it prints open side down without support. Walls + roof must stay inside the spacer and floor.
aero_channel_deg=90;        // Cable channel direction (deg): Base 10: from +x; kept between two radial screws and clear of the four tool screws.
arm_roll_deg=0;             // Wrist roll shown (deg): Base 10: the reBot Arm's J6 roll in the preview (arm_pose.py, at export; not live).
aero_view_x=230;            // Aero Hand shown at x (mm): Base 10: in the preview the Aero Hand and its plate stand beside the arm, as the other tool on the rack.
mm_per_px=0.2;              // mm_per_px (mm/px): Photo scale: ~110 mm pivot to tip. No measured scale.
px_pivot=[337, 395];        // px_pivot (px): Frame origin in the two-hands photo.
axis_deg=36.5;              // axis_deg (deg): Bisector of the two closed fingers in the photo (27 and 46 deg).
contact_back=0.0005;        // contact_back (mm): How far the smoothed point sits outboard of the traced one; moves the pivots so closed the points meet. 2.5: 0.0005, 1.19's: the wide point keeps its full reach through the tip_r round (mesh innermost reach = outline's). 2.4: -0.0651.
rail_p=[[-5.06, 12.79], [-9.54, 36.26]];// rail_p (mm): Two outer-edge points of the traced outline where the edge is straight within 0.3 mm (the handle's rail).
round_back=1.5;             // round_back (mm): How far tip_r rounds the triangle point back from the trace (trace_photo.py ROUND_BACK).
max_angle=30;               // max_angle (deg): Each finger's largest swing about its pivot.

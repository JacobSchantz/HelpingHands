/* GENERALIST GRIPPER — GENERATION 9 (Sonnet 5.5, pebble voice-31ca3e68) / the two yellow fingers only, mm.
   Jake: "delete everything else, just keep the yellow grippers ... get the yellow part to
   look as close as possible to Generalist's yellow part." No body, mount, camera, straps,
   carriers, gears or drive. The outline is a pixel trace of the lower finger of the
   left-hand device in cad/reference/generalist_gripper_gen6_two_hands.png, found by colour
   (trace_photo.py -> trace_px.scad) and mapped to mm below. Every hole goes through.
   Gen 9 vs Gen 7: sharp skinny pointed tip (plan + side), smooth wedge with no crease, round holes only,
   narrower longer slots, smoothed outline.
   Axes: X across (right finger +X), Z along the fingers (tips +Z), +Y = dorsal. */
$fn=48;
part="assembly"; // assembly | left | right | collision | none | viewer_left | viewer_right
angle=15;        // each finger's swing about its pivot; 0 = closed (the photo pose)
max_angle=30;

// ---------- photo -> mm ----------
include <trace_px.scad>   // outline_px, holes_px, dot_px, slots_px, tip_px, jaw_path_px: generated by trace_photo.py
mm_per_px=0.2;            // ~110 mm pivot-to-tip; no measured scale, see README
px_pivot=[337,395];       // frame origin only: the photo shows the lip solid, so no bore is cut (the joint is under the carrier)
axis_deg=36.5;            // bisector of the two closed fingers in the photo (27 and 46 deg)
plate=13;                 // finger thickness along Y, centred on the hand plane: the side and robot photos
                          // show the blade about as thick as it is wide
tip_thick=1.2;            // from the black dot the blade wedges down to this knife-edge at the point (Gen 7: 4 mm)
tip_gap=1.0;              // closed tip-to-tip gap

// finger frame (right finger): pivot at origin, inner (gripping) side is -X
function px(q)=let(d=[q[0],q[1]]-px_pivot) mm_per_px*[-(d[0]*sin(axis_deg)-d[1]*cos(axis_deg)), d[0]*cos(axis_deg)+d[1]*sin(axis_deg)];
function pxs(l)=[for(q=l) px(q)];

tip=px(tip_px);
dot_z=px(dot_px)[1];      // the wedge starts at the black dot (side + robot photos)
pivot=-min([for(p=pxs(outline_px)) p[0]])+tip_gap/2;  // half the pivot spacing: closed jaws sit tip_gap apart
min_hole=1.4;             // blurred small holes are read no smaller than this
min_slot=1.2;             // ...and an oval no narrower than this
slot=[3.1,1.3];           // blade slot length x width, ~2.4:1 (photo: narrower and longer than Gen 7); the last one is ~70%
function frame_deg(img_deg)=90-(img_deg-axis_deg);   // a direction in the photo -> angle in the finger frame

module profile() {   // photo blur -> smooth edges; the needle tip is kept unrounded
    offset(r=0.8) offset(delta=-1.6) offset(r=0.8) polygon(pxs(outline_px));
    intersection() {polygon(pxs(outline_px)); translate([-60,tip_z-9]) square([120,20]);}
}
module holes2d() {
    for(h=holes_px) translate(px(h))
        circle(d=max(min_hole,(h[2]+h[3])/2*mm_per_px));   // all round: the photo reads every bar hole round
    translate(px(dot_px)) circle(d=dot_px[2]*mm_per_px);
    for(i=[0:len(slots_px)-1]) translate(px(slots_px[i])) rotate(frame_deg(120))   // slanted like a forward slash in the photo, ~35 deg off the row
        scale(i==len(slots_px)-1?0.7:1) hull() for(s=[-1,1]) translate([s*(slot[0]-slot[1])/2,0]) circle(d=slot[1],$fn=16);
}
// Ridges: a continuous row of V teeth cut square into the inner (gripping) edge along its drawn path
// (jaw_path_px), through the full thickness. r2 review: 8-12 teeth so they read in the top and open views.
function cumlen(p)=[for(i=0,c=0;i<len(p);c=c+norm(p[min(i+1,len(p)-1)]-p[i]),i=i+1) c];
ridge_n=11;ridge_start=22;ridge_pitch=8.6;   // px along the path; ridge_depth mm; ridge_w mm (mouth of each V)
ridge_depth=0.9;ridge_w=1.3;
module ridges2d() {
    cl=cumlen(jaw_path_px);
    for(i=[0:ridge_n-1]) let(s=ridge_start+i*ridge_pitch,
        k=max([for(j=[0:len(cl)-2]) if(cl[j]<=s) j]),
        p=jaw_path_px[k]+(jaw_path_px[k+1]-jaw_path_px[k])*(s-cl[k])/(cl[k+1]-cl[k]),
        u=(jaw_path_px[k+1]-jaw_path_px[k])/norm(jaw_path_px[k+1]-jaw_path_px[k]), v=[-u[1],u[0]],
        w=ridge_w/2/mm_per_px, d=ridge_depth/mm_per_px)      // v points into the finger (down in the photo)
        polygon(pxs([p-u*w-v*4, p+u*w-v*4, p+u*w*0.15+v*d, p-u*w*0.15+v*d]));
}
tip_z=max([for(p=pxs(outline_px)) p[1]]);
function ease(t)=t*t*(2-t);   // 0 slope at the dot (no crease), straight wedge into the point
function half_thick(z)=let(t=min(1,max(0,(z-dot_z)/(tip_z-dot_z)))) (plate-(plate-tip_thick)*ease(t))/2;
module side_taper() {     // Y-Z wedge: full plate to the dot, then thinning smoothly to a knife-edge point
    N=160;
    rotate([90,0,90]) linear_extrude(200,center=true)
        polygon(concat([[-plate/2-1,-50],[plate/2+1,-50]],
            [for(i=[0:N]) let(z=dot_z+(tip_z+1-dot_z)*i/N) [half_thick(z),z]],
            [for(i=[N:-1:0]) let(z=dot_z+(tip_z+1-dot_z)*i/N) [-half_thick(z),z]]));
}
module xz(h) {rotate([-90,0,0]) mirror([0,1,0]) linear_extrude(h,center=true) children();}
module finger() {
    difference() {
        intersection() {xz(plate) profile(); side_taper();}
        xz(plate+2) holes2d();          // every hole goes all the way through (Jake)
        xz(plate+2) ridges2d();
    }
}
module placed(s=1,a=angle) {
    translate([s*pivot,0,0]) rotate([0,s*a,0]) if(s<0) mirror([1,0,0]) children(); else children();
}
module piece(q,a=angle) {
    if(q=="left") placed(-1,a) finger();
    if(q=="right") placed(1,a) finger();
}
module clash(a=angle) {intersection(){piece("left",a);piece("right",a);}}
assert(angle>=0&&angle<=max_angle,"Angle outside intended motion");
if(part=="assembly") color("#efb83b") {piece("left");piece("right");}
if(part=="right") color("#efb83b") finger();
if(part=="left") color("#efb83b") mirror([1,0,0]) finger();
if(part=="collision") clash();
for(q=["left","right"]) if(part==str("viewer_",q)) piece(q);

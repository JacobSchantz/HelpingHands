/* GENERALIST GRIPPER — GENERATION 7 / the two yellow fingers only, mm.
   Jake: "delete everything else, just keep the yellow grippers ... get the yellow part to
   look as close as possible to Generalist's yellow part." No body, mount, camera, straps,
   carriers, gears or drive. The outline is a pixel trace of the lower finger of the
   left-hand device in cad/reference/generalist_gripper_gen6_two_hands.png, found by colour
   (trace_photo.py -> trace_px.scad) and mapped to mm below. Every hole goes through.
   Axes: X across (right finger +X), Z along the fingers (tips +Z), +Y = dorsal. */
$fn=32;
part="assembly"; // assembly | left | right | collision | none | viewer_left | viewer_right
angle=15;        // each finger's swing about its pivot; 0 = closed (the photo pose)
max_angle=30;

// ---------- photo -> mm ----------
include <trace_px.scad>   // outline_px, holes_px, dot_px, slots_px, tip_px: generated by trace_photo.py
mm_per_px=0.2;            // ~110 mm pivot-to-tip; no measured scale, see README
px_pivot=[337,395];       // placeholder pivot in the solid root lip, clear of the carrier slot
axis_deg=36.5;            // bisector of the two closed fingers in the photo (27 and 46 deg)
plate=12;                 // finger thickness along Y at the root and bar, centred on the hand plane
tip_thick=5;              // the blade thins from the knee to a chisel point (robot + side photos)
pivot_bore=3.0;
tip_gap=1.0;              // closed tip-to-tip gap

// finger frame (right finger): pivot at origin, inner (gripping) side is -X
function px(q)=let(d=[q[0],q[1]]-px_pivot) mm_per_px*[-(d[0]*sin(axis_deg)-d[1]*cos(axis_deg)), d[0]*cos(axis_deg)+d[1]*sin(axis_deg)];
function pxs(l)=[for(q=l) px(q)];

tip=px(tip_px);
knee_z=px([662,562])[1];  // outer knee: where the black carrier ends and the blade starts
pivot=-min([for(p=pxs(outline_px)) p[0]])+tip_gap/2;  // half the pivot spacing: closed jaws sit tip_gap apart
min_hole=1.8;             // blurred small holes are read no smaller than this

module profile() {polygon(pxs(outline_px));}
module holes2d() {
    for(h=holes_px) translate(px(h)) circle(d=max(min_hole,h[2]*mm_per_px));
    translate(px(dot_px)) circle(d=dot_px[2]*mm_per_px);
    for(q=slots_px) translate(px(q)) rotate(axis_deg-120) hull()   // slanted, as in the photo
        for(s=[-1,1]) translate([s*0.6,0]) circle(d=1.1,$fn=12);
}
module side_taper() {     // Y-Z wedge: full plate to the knee, then thinning to the tip
    rotate([90,0,90]) linear_extrude(200,center=true)
        polygon([[-plate/2-1,-50],[plate/2+1,-50],[plate/2,knee_z],[tip_thick/2,tip[1]+2],
                 [-tip_thick/2,tip[1]+2],[-plate/2,knee_z]]);
}
module xz(h) {rotate([-90,0,0]) mirror([0,1,0]) linear_extrude(h,center=true) children();}
module finger() {
    difference() {
        intersection() {xz(plate) profile(); side_taper();}
        xz(plate+2) holes2d();          // every hole goes all the way through (Jake)
        xz(plate+2) circle(d=pivot_bore);
    }
}
module placed(s=1,a=angle) {
    translate([s*pivot,0,0]) rotate([0,s*a,0]) if(s<0) mirror([1,0,0]) children(); else children();
}
module piece(q,a=angle) {
    if(q=="left") placed(-1,a) finger();
    if(q=="right") placed(1,a) finger();
}
module clash(a=angle) {intersection(){piece("left",a);piece("right",a);}}
assert(angle>=0&&angle<=max_angle,"Angle outside intended motion");
if(part=="assembly") color("#efb83b") {piece("left");piece("right");}
if(part=="right") color("#efb83b") finger();
if(part=="left") color("#efb83b") mirror([1,0,0]) finger();
if(part=="collision") clash();
for(q=["left","right"]) if(part==str("viewer_",q)) piece(q);

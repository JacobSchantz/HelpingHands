/* GENERALIST GRIPPER — GENERATION 15, PRINTABLE HANDHELD / the whole device, mm.
   Jake (voice-492e118c): "I'm happy with Gen 14. Let's move forward with making it printable. Gen 15: keep that,
   but from the photos add the rest of it: the actual attachment mechanism and stuff, and the ability to attach a
   camera."
   FINGERS: Gen 14's (voice-fe67959c) shape and closed contact, changed only to print:
     * tip_thick 1.6 -> 2.0 mm (the beak's thickness at the point: 5 perimeters, not 4);
     * ridge_wall 0.6 -> 0.8 mm: grooves stop 2 perimeters short of a hole (Gen 14 left 0.6 mm walls near the tip);
     * the two honeycomb holes the carrier bolts through open to 3.2 mm (M3 clearance; were 3.0 and 2.7);
     * the tip pad prints merged with the finger (print/*_finger.stl) unless you have two materials.
   THE REST, from the photos (cad/reference/generalist_gripper_gen6_*.png): each finger is bolted into a dark
   CARRIER that rides on the thumb (right finger, +X) or the index finger (left, -X) with a strap; the carrier holds
   the pivot nut, so the finger root is not drilled. A PIVOT PLATE above both carriers holds the two pivots at Gen 14's
   +-27.137 mm. The HAND FRAME bolts on top of it and lies on the back of the hand (wrist strap); the CAMERA MOUNT
   holds an Insta360 X4/X5 upright on the frame, lenses facing forward/back. Everything sits ABOVE the hand
   (+Y, dorsal); nothing hangs into the thumb-index web.
   Axes: X across (right finger +X), Z along the fingers (tips +Z), +Y = dorsal. This is a RIGHT-hand build
   (seen from above the thumb is on the right finger, +X); mirror X for a left hand. */
$fn=32;
part="assembly"; // assembly | none | collision | viewer_<name> (placed, for the gallery) | print_<name> (print orientation); see PARTS below
angle=15;        // each finger's swing about its pivot; 0 = closed (the photo pose)
max_angle=30;

// ---------- photo -> mm ----------
include <trace_px.scad>   // outline_px, holes_px, dot_px, slots_px, tip_px: generated by trace_photo.py
mm_per_px=0.2;            // ~110 mm pivot-to-tip; no measured scale, see README
px_pivot=[337,395];       // frame origin only: the photo shows the lip solid, so no bore is cut (the joint is under the carrier)
axis_deg=36.5;            // bisector of the two closed fingers in the photo (27 and 46 deg)
plate=12;                 // finger thickness along Y, centred on the hand plane: the side and robot photos
                          // show the blade about as thick as it is wide
tip_thick=2.0;            // from the black dot the blade thins smoothly (no crease) to this at the point (Gen 14: 1.6; Gen 10: 2.0)
tip_gap=0;                // closed: the points touch (Gen 11: 1.0 mm apart)
contact_back=-0.028;      // how far the smoothed point sits outboard of the traced one (see pivot). Gen 14: tip_r's rounding
                          // leaves the innermost reach 0.028 mm inside the trace (mesh min x -27.137 vs -27.165), so the pivots move in by that
tip_r=0.3;                // Gen 14: plan-view radius of the point (Gen 13 rounded it ~1 mm, two nubs with a V between)
tip_zone=6;               // the sharper rounding applies within this many mm of the point; elsewhere Gen 13's
pad_len=2.5;              // Gen 14: the dark tip, this long along Z (the photos' dark nub is ~2-3 mm; r1: 3.5, read as long)

// finger frame (right finger): pivot at origin, inner (gripping) side is -X
function px(q)=let(d=[q[0],q[1]]-px_pivot) mm_per_px*[-(d[0]*sin(axis_deg)-d[1]*cos(axis_deg)), d[0]*cos(axis_deg)+d[1]*sin(axis_deg)];
function pxs(l)=[for(q=l) px(q)];

tip=px(tip_px);
dot_z=px(dot_px)[1];      // the wedge starts at the black dot (side + robot photos)
pivot=-min([for(p=pxs(outline_px)) p[0]])+contact_back+tip_gap/2;  // half the pivot spacing: the traced point is the innermost reach, so closed the points meet
min_hole=1.8;             // blurred small holes are read no smaller than this
ridge=[1.0,0.5,0.4];      // inner-edge grooves: pitch (set in trace_photo.py), width, depth (mm), across the full thickness.
                          // Gen 12's shallow 0.4 mm; the closed photo shows them along essentially the whole inner edge
ridge_wall=0.8;           // least wall kept between a groove and any hole: two 0.4 mm perimeters (Gen 14: 0.6)
slot=[3.0,1.35];          // blade slot length x width, ~2.2:1 like the photo; the last one is ~70%
function frame_deg(img_deg)=90-(img_deg-axis_deg);   // a direction in the photo -> angle in the finger frame

module profile() {     // photo blur -> smooth edges: Gen 13's rounding everywhere, except a sharper tip_r at the point
    tipbox=[[-60,tip[1]-tip_zone],[60,tip[1]-tip_zone],[60,tip[1]+10],[-60,tip[1]+10]];
    union() {
        difference() {profile_body(); polygon(tipbox);}
        intersection() {offset(r=-1.2) offset(delta=1.2) offset(r=tip_r) offset(delta=-tip_r) polygon(pxs(outline_px)); polygon(tipbox);}
    }
}
module profile_body() {   // Gen 13: 0.5 mm on convex corners (r2: 0.35 was a fragile spike), 1.2 mm fillets in concave ones (the shoulder)
    offset(r=-1.2) offset(delta=1.2) offset(r=0.5) offset(delta=-1.0) offset(r=0.5) polygon(pxs(outline_px));
}
module holes2d() {
    for(h=holes_px) translate(px(h))
        circle(d=max(min_hole,(h[2]+h[3])/2*mm_per_px));   // the photo reads every honeycomb hole round (Gen 7 r4 review)
    translate(px(dot_px)) circle(d=dot_px[2]*mm_per_px);
    for(h=bolt_holes) translate(h) circle(d=m3);   // Gen 15: the carrier's two bolts (these were honeycomb holes)
    intersection() {   // Gen 15: a slot keeps ridge_wall to the edge (the last one came within 0.66 mm of the beak's edge)
        union() for(i=[0:len(slots_px)-1]) translate(px(slots_px[i])) rotate(frame_deg(120))   // slanted like a forward slash in the photo, ~35 deg off the row
            scale(i==len(slots_px)-1?0.7:1) hull() for(s=[-1,1]) translate([s*(slot[0]-slot[1])/2,0]) circle(d=slot[1],$fn=16);
        offset(r=-ridge_wall-0.05) profile();   // +0.05: not exactly ridge_wall, or the grooves' stop line lands on the edge (non-manifold)
    }
}
module ridges2d() {       // one groove per station on the inner edge (ridges_px from trace_photo.py), square to the edge.
    // Its depth is measured from the finished edge (the band between profile() and its inset), and it stops
    // ridge_wall short of every hole, so the grooves are all exactly ridge[2] deep and never open a hole.
    difference() {
        intersection() {
            for(r=ridges_px) let(c=px([r[0],r[1]]), n=px([r[0]+r[2],r[1]+r[3]])-c, a=atan2(n[1],n[0]))
                translate(c) rotate(a) translate([-2*ridge[2],-ridge[1]/2]) square([4*ridge[2],ridge[1]]);
            difference() {offset(delta=1) profile(); offset(r=-ridge[2]) profile();}   // past the edge, so no skin is left
        }
        offset(r=ridge_wall) holes2d();
    }
}
function half_thick(f)=(tip_thick+(plate-tip_thick)*(1-f*f))/2;   // flat at the dot (no crease), steepest at the point: a beak
module side_taper(inset=0) {   // Y-Z profile: full plate to the dot, beak on both faces, rounded nub at the point; inset shrinks each face
    r=tip_thick/2; L=tip[1]-r-dot_z; n=16;
    rotate([90,0,90]) linear_extrude(200,center=true)
        polygon(concat([[-plate/2-1,-50],[plate/2+1,-50]],
                       [for(i=[0:n]) [half_thick(i/n)-inset,dot_z+L*i/n]],
                       [for(a=[10:10:170]) [max(0.05,r-inset)*cos(a),tip[1]-r+max(0.05,r-inset)*sin(a)]],
                       [for(i=[n:-1:0]) [-(half_thick(i/n)-inset),dot_z+L*i/n]]));
}
module xz(h) {rotate([-90,0,0]) mirror([0,1,0]) linear_extrude(h,center=true) children();}
module pad_zone() {translate([-60,-20,tip[1]-pad_len]) cube([120,40,20]);}
module finger() {difference() {whole_finger(); pad_zone();}}           // the yellow body
module tip_pad() {intersection() {whole_finger(); pad_zone();}}         // the dark tip
module whole_finger() {
    difference() {
        intersection() {xz(plate) profile(); side_taper();}
        xz(plate+2) holes2d();          // every hole goes all the way through (Jake)
        xz(plate+2) ridges2d();         // the grooves run across the full thickness of the gripping face (Jake)
    }
}
module placed(s=1,a=angle) {
    translate([s*pivot,0,0]) rotate([0,s*a,0]) if(s<0) mirror([1,0,0]) children(); else children();
}
module piece(q,a=angle) {   // a whole finger, body + pad: what the contact checks use
    if(q=="left") placed(-1,a) whole_finger();
    if(q=="right") placed(1,a) whole_finger();
}
module clash(a=angle) {intersection(){piece("left",a);piece("right",a);}}

// ================= Gen 15: the rest of the device =================
// Finger-frame numbers below are for the RIGHT (thumb) side; placed(-1) mirrors them for the left (index) side.
m3=3.2;                   // M3 clearance in the finger and printed parts (finger: was honeycomb 3.0 / 2.7)
m3_free=3.4;              // M3 clearance where nothing locates on the bolt
bolt_holes=[[-11.2,16.3],[-11.2,27.4]];   // finger frame (x,z): the two honeycomb holes on the shaft centreline the carrier bolts through
// carrier: a dark block on the finger's dorsal face (Y=+6) that the thumb/index rides under, strapped in
car_y=[6,15];             // its thickness band; the finger is Y -6..6
car_r=9;                  // round boss about the pivot
car_box=[[-18,8],[30,44]];// (x,z) rectangle over the finger root + the digit
car_lip=[0.2,2.7];        // a lip hugs the finger's outer edge (gap, outer offset) so the two bolts are not the only locators
lip_z=[5,44];
digit=[13,-4,11.25];      // nominal thumb/index proximal phalanx under the carrier: centre x, y and radius (22.5 mm)
strap_w=20;               // 20 mm hook-and-loop strap; the slots also take zip ties up to ~5 x 1.5 mm
strap_slots=[[-1,3],[23,27]];   // x ranges of the two strap slots, either side of the digit
strap_z=[17,39];          // slot length along Z (strap_w + 2)
strap_t=1.5;
nut_af=7.3; nut_h=[7.4,12.6];   // M4 nylon-insert nut (7 AF x 5.0) captive in the carrier, slid in from the back
pivot_bore=4.4;           // M4 running clearance in the pivot plate and carrier (printed holes shrink ~0.1)
washer=0.8;               // M4 washer between carrier and pivot plate
plate_y=[car_y[1]+washer,car_y[1]+washer+6];        // pivot plate 15.8..21.8
frame_y=[plate_y[1],plate_y[1]+5];                  // hand frame 21.8..26.8, on top of the pivot plate
plate_bolts=[[12,-13],[-12,-13],[12,-25],[-12,-25]];// frame -> pivot plate, M3 into heat-set inserts in the plate
insert_d=4.0;             // M3 x 5.7 heat-set insert pilot
wrist=[-50,-10,30,22];    // nominal wrist: centre x, y and half-width, half-height (an ellipse, 60 x 44 mm)
wrist_z=[-121,-99];       // the wrist strap's band (22 mm, for a 20-25 mm strap); slots run along it
wrist_slots=[[-84,-80],[-20,-16]];
rails=[[-80,-72],[-28,-20]];   // two rails under the frame rest on the back of the hand (add 3 mm foam)
rail_y=14; rail_z=[-95,-55];
cam=[-18,-60];            // camera (x,z) on the frame, behind the thumb-index web and the pivot plate
cam_box=[46,123.6,37.6];  // Insta360 X4 (X5: 46 x 124.5 x 38.2); upright, lenses on the +-Z faces
cam_pocket=[46.8,39.0];   // fits both, 0.4 mm a side on the X5
cam_wall=3; cam_base=4; cam_wall_h=10;
cam_bolts=[[18,27],[-18,27],[18,-27],[-18,-27]];    // cradle -> frame, M3 + nut under the frame
quarter=6.7;              // 1/4"-20 clearance: the camera's own tripod thread, screw from under the frame

module fy(y0,y1) {translate([0,y1,0]) rotate([90,0,0]) linear_extrude(y1-y0) children();}   // 2D (x,z) -> slab Y y0..y1
module carrier2d() {
    difference() {
        hull() {circle(r=car_r,$fn=48); translate(car_box[0]) square(car_box[1]-car_box[0]);}
        for(s=strap_slots) translate([s[0],strap_z[0]]) square([s[1]-s[0],strap_z[1]-strap_z[0]]);
        for(h=bolt_holes) translate(h) circle(d=m3);
        circle(d=pivot_bore);
    }
}
module carrier() {   // right (thumb) carrier, finger frame
    difference() {
        union() {
            fy(car_y[0],car_y[1]) carrier2d();
            fy(-plate/2,car_y[0]+0.01) intersection() {      // the lip down the finger's outer edge
                difference() {offset(r=car_lip[1]) profile(); offset(r=car_lip[0]) profile();}
                translate([-12,lip_z[0]]) square([11,lip_z[1]-lip_z[0]]);
            }
        }
        fy(nut_h[0],nut_h[1]) {rotate(30) circle(d=nut_af/cos(30),$fn=6); translate([-nut_af/2,-car_r-2]) square([nut_af,car_r+2]);}
        fy(car_y[1]-3,car_y[1]+1) for(h=bolt_holes) translate(h) circle(d=5.8);   // M3 socket heads sit flush
    }
}
module digit_strap() {   // non-printed: around the digit, up through both slots, closing over the carrier
    o=strap_t;
    translate([0,0,strap_z[0]+1]) linear_extrude(strap_w) difference() {
        hull() {translate([digit[0],digit[1]]) circle(r=digit[2]+o,$fn=64); translate([strap_slots[0][0]+1,digit[1]]) square([strap_slots[1][1]-strap_slots[0][0]-2,car_y[1]+o-digit[1]]);}
        hull() {translate([digit[0],digit[1]]) circle(r=digit[2],$fn=64); translate([strap_slots[0][0]+1+o,digit[1]]) square([strap_slots[1][1]-strap_slots[0][0]-2-2*o,car_y[1]-digit[1]]);}
    }
}
module plate2d() {
    difference() {
        hull() {for(s=[-1,1]) translate([s*pivot,0]) circle(r=10,$fn=64); translate([-20,-30]) square([40,22]);}
        for(s=[-1,1]) translate([s*pivot,0]) circle(d=pivot_bore);
        for(b=plate_bolts) translate(b) circle(d=insert_d);
    }
}
module pivot_plate() {fy(plate_y[0],plate_y[1]) plate2d();}
module frame2d() {
    difference() {
        hull() {
            translate([-22,-32]) square([44,24]);                       // over the pivot plate's tab
            translate([cam[0]-30,cam[1]-34]) square([60,68]);           // the camera pad
            translate([-88,wrist_z[0]-4]) square([76,wrist_z[1]-wrist_z[0]+8]);   // across the wrist
        }
        for(s=wrist_slots) translate([s[0],wrist_z[0]]) square([s[1]-s[0],wrist_z[1]-wrist_z[0]]);
        for(b=plate_bolts) translate(b) circle(d=m3_free);
        translate(cam) {circle(d=quarter); for(b=cam_bolts) translate(b) circle(d=m3_free);}
        translate([-62,-82]) rotate(48) hull() for(t=[-11,11]) translate([t,0]) circle(r=6);   // lightening, clear of rails and bolts
    }
}
module hand_frame() {
    difference() {
        union() {
            fy(frame_y[0],frame_y[1]) frame2d();
            for(r=rails) fy(rail_y,frame_y[0]+0.01) translate([r[0],rail_z[0]]) square([r[1]-r[0],rail_z[1]-rail_z[0]]);
        }
        fy(frame_y[1]-3,frame_y[1]+1) for(b=plate_bolts) translate(b) circle(d=5.8);   // heads flush
    }
}
module camera_mount() {
    y0=frame_y[1]; pw=cam_pocket[0]+2*cam_wall; pd=cam_pocket[1]+2*cam_wall;
    translate([cam[0],0,cam[1]]) difference() {
        union() {
            fy(y0,y0+cam_base) translate([-pw/2,-30.5]) square([pw,61]);
            fy(y0+cam_base-0.01,y0+cam_base+cam_wall_h) difference() {square([pw,pd],center=true); square(cam_pocket,center=true);}
        }
        fy(y0-1,y0+cam_base+1) {circle(d=quarter); for(b=cam_bolts) translate(b) circle(d=m3_free);}
        fy(y0+cam_base+3,y0+cam_base+cam_wall_h+1) translate([-pw,-6]) square([2*pw,12]);   // finger notches in the side walls to lift the camera out
    }
}
module camera() {   // non-printed: Insta360 X4-size, upright, a lens on each of the +-Z faces near the top
    y0=frame_y[1]+cam_base;
    translate([cam[0],y0,cam[1]]) {
        hull() for(x=[-1,1],z=[-1,1]) translate([x*(cam_box[0]/2-6),0,z*(cam_box[2]/2-6)]) rotate([-90,0,0]) cylinder(r=6,h=cam_box[1],$fn=24);
        for(s=[-1,1]) translate([0,cam_box[1]-22,s*cam_box[2]/2]) scale([1,1,0.45*s]) sphere(d=26,$fn=48);
    }
}
module wrist_strap() {   // non-printed: under the wrist, up through the frame's two slots, closing over the frame
    o=strap_t; e=wrist;
    translate([0,0,wrist_z[0]+1]) linear_extrude(wrist_z[1]-wrist_z[0]-2) difference() {
        hull() {translate([e[0],e[1]]) scale([e[2]+o,e[3]+o]) circle(r=1,$fn=96); translate([wrist_slots[0][0]+0.5,e[1]]) square([wrist_slots[1][1]-wrist_slots[0][0]-1,frame_y[1]+o-e[1]]);}
        hull() {translate([e[0],e[1]]) scale([e[2],e[3]]) circle(r=1,$fn=96); translate([wrist_slots[0][0]+0.5+o,e[1]]) square([wrist_slots[1][1]-wrist_slots[0][0]-1-2*o,frame_y[1]-e[1]]);}
    }
}

module placed(s=1,a=angle) {
    translate([s*pivot,0,0]) rotate([0,s*a,0]) if(s<0) mirror([1,0,0]) children(); else children();
}
module piece(q,a=angle) {   // a whole finger, body + pad: what the contact checks use
    if(q=="left") placed(-1,a) whole_finger();
    if(q=="right") placed(1,a) whole_finger();
}
module clash(a=angle) {intersection(){piece("left",a);piece("right",a);}}
module moving(s,a=angle) {placed(s,a) {whole_finger(); carrier(); digit_strap();}}   // everything that swings with one finger
module fixed() {pivot_plate(); hand_frame(); camera_mount(); camera(); wrist_strap();}
module web_zone() {translate([-12,-40,-60]) cube([24,40+car_y[1],60]);}   // the thumb-index web under the pivot plate: keep empty

// ---------- parts: [name, colour, explode, printed] ----------
YEL="#efb83b"; DARK="#46464c"; PADC="#2a2a2c"; CAM="#26262a"; STRAP="#5a4632";
module part_geom(n) {   // assembled position
    if(n=="right_finger") placed(1) finger();
    if(n=="left_finger") placed(-1) finger();
    if(n=="right_pad") placed(1) tip_pad();
    if(n=="left_pad") placed(-1) tip_pad();
    if(n=="right_carrier") placed(1) carrier();
    if(n=="left_carrier") placed(-1) carrier();
    if(n=="right_strap") placed(1) digit_strap();
    if(n=="left_strap") placed(-1) digit_strap();
    if(n=="pivot_plate") pivot_plate();
    if(n=="hand_frame") hand_frame();
    if(n=="camera_mount") camera_mount();
    if(n=="camera") camera();
    if(n=="wrist_strap") wrist_strap();
}
module print_geom(n) {   // print orientation, sitting on z=0 (slicer Z up)
    if(n=="right_finger") translate([0,0,plate/2]) rotate([90,0,0]) whole_finger();          // flat; support under the beak only
    if(n=="left_finger") mirror([1,0,0]) print_geom("right_finger");
    if(n=="right_finger_body") translate([0,0,plate/2]) rotate([90,0,0]) finger();          // two-material option
    if(n=="left_finger_body") mirror([1,0,0]) print_geom("right_finger_body");
    if(n=="right_pad") translate([0,0,plate/2]) rotate([90,0,0]) tip_pad();
    if(n=="left_pad") mirror([1,0,0]) print_geom("right_pad");
    if(n=="right_carrier") translate([0,0,car_y[1]]) rotate([-90,0,0]) carrier();            // top face down: lip and nut slot up
    if(n=="left_carrier") mirror([1,0,0]) print_geom("right_carrier");
    if(n=="pivot_plate") translate([0,0,-plate_y[0]]) rotate([90,0,0]) pivot_plate();
    if(n=="hand_frame") translate([0,0,frame_y[1]]) rotate([-90,0,0]) hand_frame();          // top face down: rails up
    if(n=="camera_mount") translate([0,0,-frame_y[1]]) rotate([90,0,0]) camera_mount();
}
assert(angle>=0&&angle<=max_angle,"Angle outside intended motion");
if(part=="assembly") {
    color(YEL) for(s=[-1,1]) placed(s) finger();
    color(PADC) for(s=[-1,1]) placed(s) tip_pad();
    color(DARK) {for(s=[-1,1]) placed(s) carrier(); pivot_plate(); hand_frame(); camera_mount();}
    color(CAM) camera();
    color(STRAP) {for(s=[-1,1]) placed(s) digit_strap(); wrist_strap();}
}
if(part=="collision") clash();
if(len(part)>7 && substr7(part)=="viewer_") part_geom(after(part,7));
if(len(part)>6 && substr6(part)=="print_") print_geom(after(part,6));
function substr7(s)=str(s[0],s[1],s[2],s[3],s[4],s[5],s[6]);
function substr6(s)=str(s[0],s[1],s[2],s[3],s[4],s[5]);
function after(s,n)=n>=len(s)?"":str(s[n],after(s,n+1));

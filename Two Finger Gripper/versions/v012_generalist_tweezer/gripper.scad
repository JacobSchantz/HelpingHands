/* GENERALIST GRIPPER — GENERATION 12, THE TWEEZER (built by Opus 5.5) / the two yellow fingers only, mm.
   Jake (voice-438af2a9): "basically a set of tweezers that can follow the fingers. Pretty similar to
   what we have now, but significantly smaller at the end, and more tweezer-like."
   Starts from Gen 11 r4 (Gen 10's beak, same pivot idea, same honeycomb root). Past the black dot the
   blade becomes a tine: its outer edge tapers (tine_out) to a 1.4 mm tip, its jaw edge runs straight
   along a flat land (land_x) for the last 11 mm, and the two lands close flat against each other at
   angle 0 (tip_gap=0). The thickness thins along (1-f)^1.5, so the last few mm are a flat blade, not a
   beak. Grooves (r2): fine shallow cross-cuts along the whole inner edge, from the head corner to 1 mm
   short of the tip (Jake: the closed photo shows the serration spanning essentially the entire inner edge).
   The root (honeycomb, dot, first slots) is still the pixel trace of the lower finger of the
   left-hand device in cad/reference/generalist_gripper_gen6_two_hands.png (trace_photo.py ->
   trace_px.scad), mapped to mm below. Every hole goes through.
   Axes: X across (right finger +X), Z along the fingers (tips +Z), +Y = dorsal. */
$fn=32;
part="assembly"; // assembly | left | right | collision | none | viewer_left | viewer_right
angle=15;        // each finger's swing about its pivot; 0 = closed (the photo pose)
max_angle=30;

// ---------- photo -> mm ----------
include <trace_px.scad>   // outline_px, holes_px, dot_px, slots_px, tip_px: generated by trace_photo.py
mm_per_px=0.2;            // ~110 mm pivot-to-tip; no measured scale, see README
px_pivot=[337,395];       // frame origin only: the photo shows the lip solid, so no bore is cut (the joint is under the carrier)
axis_deg=36.5;            // bisector of the two closed fingers in the photo (27 and 46 deg)
plate=12;                 // finger thickness along Y, centred on the hand plane: the side and robot photos
                          // show the blade about as thick as it is wide
tip_thick=2.4;            // the tip pad's height along Y: a flat 2.4 x 1.4 mm tweezer tip (Gen 11: a 1.6 mm point)
tip_gap=0;                // tweezer: the lands meet flat at angle 0 (Gen 11: 1.0 mm apart)

// finger frame (right finger): pivot at origin, inner (gripping) side is -X
function px(q)=let(d=[q[0],q[1]]-px_pivot) mm_per_px*[-(d[0]*sin(axis_deg)-d[1]*cos(axis_deg)), d[0]*cos(axis_deg)+d[1]*sin(axis_deg)];
function pxs(l)=[for(q=l) px(q)];

tip0=px(tip_px);
dot_z=px(dot_px)[1];      // the wedge starts at the black dot (side + robot photos)
// ---------- the tweezer tine (finger frame) ----------
land_x=-27.1;             // the jaw edge's flat land: Gen 11's innermost reach, so the pivot spacing is unchanged within 0.6 mm
tine_z0=80;               // the tine starts just before the black dot; the root behind it is Gen 11's
land_z=96;                // the land runs straight from here to the tip: the faces that meet
tip_w=1.4;                // tine depth (X) at the tip, jaw face to back
tine_p=1.6;               // outer-edge taper exponent: >1 thins it early, so the last 10 mm are slender
tip=[land_x+tip_w/2,tip0[1]];   // same reach as Gen 11 (z ~107)
function tine_out(z)=let(f=min(1,max(0,(z-tine_z0)/(tip[1]-tine_z0)))) land_x+tip_w+(-13-land_x-tip_w)*pow(1-f,tine_p);
pivot=-land_x+tip_gap/2;  // half the pivot spacing: closed lands sit tip_gap apart
slots_kept=[for(q=slots_px) if(px(q)[1]<94) q];   // the tine is too slender for Gen 11's last slots
min_hole=1.8;             // blurred small holes are read no smaller than this
ridge=[1.0,0.5,0.4];      // inner-edge grooves: pitch (set in trace_photo.py for the traced edge), width, depth (mm), across the full thickness
ridge_wall=0.6;           // least wall kept between a groove and any hole, so no groove opens into one
ridge_stop=1.0;           // the grooves stop this far back from the tip: the very tip stays smooth
slot=[3.0,1.35];          // blade slot length x width, ~2.2:1 like the photo; the last one is ~70%
function frame_deg(img_deg)=90-(img_deg-axis_deg);   // a direction in the photo -> angle in the finger frame

module traced() {     // Gen 11's photo outline, smoothed: 0.5 mm on convex corners, 1.2 mm fillets in concave ones
    offset(r=-1.2) offset(delta=1.2) offset(r=0.5) offset(delta=-1.0) offset(r=0.5) polygon(pxs(outline_px));
}
module tine_envelope(n=40) {   // everything inboard of the tapering outer edge, from tine_z0 to the tip
    polygon(concat([[land_x,tine_z0],[land_x,tip[1]]],[for(i=[n:-1:0]) let(z=tine_z0+(tip[1]-tine_z0)*i/n) [tine_out(z),z]]));
}
module profile() {   // Gen 11's root, then the tine; the land is added straight so the tips meet flat. 0.4 mm round on convex corners
    offset(r=-0.6) offset(delta=0.6) offset(r=0.4) offset(delta=-0.4) intersection() {
        union() {
            intersection() {traced(); translate([-50,-50]) square([100,tine_z0+50]);}
            intersection() {traced(); tine_envelope();}
            intersection() {tine_envelope(); translate([land_x,land_z]) square([10,tip[1]-land_z]);}
        }
        translate([land_x,-50]) square([100,200]);   // nothing reaches past the land
    }
}
module holes2d() {
    for(h=holes_px) translate(px(h))
        circle(d=max(min_hole,(h[2]+h[3])/2*mm_per_px));   // the photo reads every honeycomb hole round (Gen 7 r4 review)
    translate(px(dot_px)) circle(d=dot_px[2]*mm_per_px);
    for(i=[0:len(slots_kept)-1]) translate(px(slots_kept[i])) rotate(frame_deg(120))   // slanted like a forward slash in the photo, ~35 deg off the row
        scale(i==len(slots_kept)-1?0.7:1) hull() for(s=[-1,1]) translate([s*(slot[0]-slot[1])/2,0]) circle(d=slot[1],$fn=16);
}
module ridges2d() {       // grooves along the whole inner edge, square to it: the traced stations (ridges_px) up to the land,
    // then straight cuts along the land to ridge_stop short of the tip. Depth is measured from the finished edge (the band
    // between profile() and its inset) and every groove stops ridge_wall short of a hole, so all are exactly ridge[2] deep.
    difference() {
        intersection() {
            union() {
                for(r=ridges_px) let(c=px([r[0],r[1]]), n=px([r[0]+r[2],r[1]+r[3]])-c, a=atan2(n[1],n[0])) if(c[1]<land_z-0.8*ridge[0])
                    translate(c) rotate(a) translate([-2*ridge[2],-ridge[1]/2]) square([4*ridge[2],ridge[1]]);
                for(z=[land_z:ridge[0]:tip[1]-ridge_stop]) translate([land_x-1,z-ridge[1]/2]) square([1+2*ridge[2],ridge[1]]);
            }
            difference() {offset(delta=1) profile(); offset(r=-ridge[2]) profile();}   // past the edge, so no skin is left
        }
        offset(r=ridge_wall) holes2d();
    }
}
function half_thick(f)=(tip_thick+(plate-tip_thick)*pow(1-f,1.5))/2;   // thins early and flattens out at the tip: a tweezer blade, not Gen 11's beak
module side_taper(inset=0) {   // Y-Z profile: full plate to the dot, tapering on both faces to a flat blade with a rounded end
    r=tip_thick/2; L=tip[1]-r-dot_z; n=16;
    rotate([90,0,90]) linear_extrude(200,center=true)
        polygon(concat([[-plate/2-1,-50],[plate/2+1,-50]],
                       [for(i=[0:n]) [half_thick(i/n)-inset,dot_z+L*i/n]],
                       [for(a=[10:10:170]) [max(0.05,r-inset)*cos(a),tip[1]-r+max(0.05,r-inset)*sin(a)]],
                       [for(i=[n:-1:0]) [-(half_thick(i/n)-inset),dot_z+L*i/n]]));
}
module xz(h) {rotate([-90,0,0]) mirror([0,1,0]) linear_extrude(h,center=true) children();}
module finger() {
    difference() {
        intersection() {xz(plate) profile(); side_taper();}
        xz(plate+2) holes2d();          // every hole goes all the way through (Jake)
        xz(plate+2) ridges2d();         // the grooves run across the full thickness of the land
    }
}
module placed(s=1,a=angle) {
    translate([s*pivot,0,0]) rotate([0,s*a,0]) if(s<0) mirror([1,0,0]) children(); else children();
}
module piece(q,a=angle) {
    if(q=="left") placed(-1,a) finger();
    if(q=="right") placed(1,a) finger();
}
module clash(a=angle) {intersection(){piece("left",a);piece("right",a);}}
assert(angle>=0&&angle<=max_angle,"Angle outside intended motion");
if(part=="assembly") color("#efb83b") {piece("left");piece("right");}
if(part=="right") color("#efb83b") finger();
if(part=="left") color("#efb83b") mirror([1,0,0]) finger();
if(part=="collision") clash();
for(q=["left","right"]) if(part==str("viewer_",q)) piece(q);
